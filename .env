# ============================================================
# POD Platform — SAP S21 Server Environment Configuration
# ============================================================

# Integration Mode: 'LIVE' to connect to S21 SAP Server, 'MOCK' for offline/testing
VITE_SAP_MODE=LIVE

# SAP S21 On-Premise / Gateway OData Server URL (Use local relative proxy to bypass CORS)
VITE_SAP_S21_BASE_URL=/sap/opu/odata/sap/

# SAP Client ID (e.g. 100, 200, 800)
VITE_SAP_S21_CLIENT=200

# SAP System ID
VITE_SAP_S21_SYSTEM_ID=S21

# Service Endpoints
VITE_SAP_S21_CONTRACTS_ENDPOINT=/ZPOD_CONTRACTS_SRV/ContractSet
VITE_SAP_S21_POS_ENDPOINT=/ZPOD_PURCHASE_ORDERS_SRV/PurchaseOrderSet

# SAP Basic Credentials
VITE_SAP_S21_USERNAME=AIS_229
VITE_SAP_S21_PASSWORD=BlueCross!7Sun0

