{
  "_version": "1.12.0",
  "sap.app": {
    "id": "podzone",
    "type": "application",
    "title": "PODZO — Transport Execution & POD Verification",
    "description": "Let's make delivery simple",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "crossNavigation": {
      "inbounds": {
        "podzone-display": {
          "semanticObject": "podzone",
          "action": "display",
          "title": "PODZO Portal",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.84.0",
      "libs": {}
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    }
  },
  "sap.platform.hcp": {
    "uri": ""
  },
  "sap.cloud": {
    "public": true,
    "service": "mdr.cap.btp"
  }
}
