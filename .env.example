# ============================================================
# POD Platform — SAP S21 Server Environment Configuration
# ============================================================

# Integration Mode: 'LIVE' to connect to S21 SAP Server, 'MOCK' for offline/testing
VITE_SAP_MODE=LIVE

# SAP S21 On-Premise / Gateway OData Server URL
# Example: https://sap-gateway.company.domain:8000/sap/opu/odata/sap/
VITE_SAP_S21_BASE_URL=http://192.168.1.55:8000/sap/opu/odata/sap/



# SAP Client ID (e.g. 100, 200, 800)
VITE_SAP_S21_CLIENT=200

# SAP System ID
VITE_SAP_S21_SYSTEM_ID=S21

# # SAP S21 Service Endpoints (Custom OData / ABAP Services)
# VITE_SAP_S21_CONTRACTS_ENDPOINT=/ZPOD_CONTRACTS_SRV/ContractSet
# VITE_SAP_S21_POS_ENDPOINT=/ZPOD_PURCHASE_ORDERS_SRV/PurchaseOrderSet
# VITE_SAP_S21_ACKNOWLEDGE_PO_ENDPOINT=/ZPOD_PO_ACK_SRV/AcknowledgePOSet
# VITE_SAP_S21_SES_ENDPOINT=/ZPOD_SES_SRV/ServiceEntrySheetSet
# VITE_SAP_S21_MIRO_ENDPOINT=/ZPOD_MIRO_SRV/ParkInvoiceSet

# # Optional Proxy URL (if OData requests are routed through Node.js/SAP BTP Destination)
# VITE_SAP_S21_PROXY_URL=http://localhost:3001/api/sap

# SAP Basic Credentials
# VITE_SAP_S21_USERNAME=your_username
# VITE_SAP_S21_PASSWORD=your_password
